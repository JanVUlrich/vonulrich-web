---
import "../styles/style.scss";
import Footer from "../components/Footer.astro";

const {
  title = "Jan Volkert Ulrich | UI | UX | Design Solutions",
  description = "A UI / UX Designer for digital products, from concept to execution. Passionate about asking the right questions and finding the best solutions.",
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  bodyPage,
} = Astro.props;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Jan Volkert Ulrich" />
    <meta name="keywords" content="" />
    <meta name="color-scheme" content="dark light" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
      type="image/png"
    />
    <link rel="manifest" href="/manifest.webmanifest" />

    <script is:inline>
      document.documentElement.className +=
        "ontouchstart" in document.documentElement ? " touch" : " no-touch";
    </script>
  </head>

  <body data-page={bodyPage}>
    <script is:inline>
      const theme = localStorage.getItem("vu-theme");

      if (!theme) {
        const prefersDarkTheme = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const newTheme = prefersDarkTheme ? "dark" : "light";

        localStorage.setItem("vu-theme", newTheme);
        document.documentElement.dataset.theme = newTheme;
      } else {
        document.documentElement.dataset.theme = theme;
      }
    </script>

    <slot />

    <Footer />

    <script is:inline>
      // Workaround for iOS and Desktop Safari
      // https://developer.apple.com/forums/thread/651215

      if (document.readyState !== "loading") {
        run();
      } else {
        document.addEventListener("DOMContentLoaded", function () {
          run();
        });
      }

      function run() {
        const part1 = "mailto:";
        const part2 =
          "%6A%61%6E%76%2E%75%6C%72%69%63%68%40%67%6D%61%69%6C%2E%63%6F%6D";
        const toggle = document.querySelector("#theme-toggle");
        const currentYear = document.querySelector("[data-current-year]");

        Array.from(document.querySelectorAll("[data-email]")).forEach((el) => {
          el.addEventListener("click", (_) => {
            window.location.href = part1 + part2;
          });
        });

        if (currentYear) currentYear.textContent = new Date().getFullYear();
        if (toggle) {
          toggle.addEventListener("click", onThemeToggleClicked);
        }
      }

      function onThemeToggleClicked() {
        const prevTheme = document.documentElement.dataset.theme;
        const nextTheme = prevTheme === "light" ? "dark" : "light";
        const toggle = document.querySelector("#theme-toggle");

        localStorage.setItem("vu-theme", nextTheme);
        document.documentElement.dataset.theme = nextTheme;
        if (prevTheme) {
          toggle.classList.remove(prevTheme);
        }
        toggle.classList.add(nextTheme);
      }
    </script>
  </body>
</html>
