---
import Footer from "../components/static/Footer.astro";
import "../styles/style.scss";

export interface Props {
  readonly title: string;
  readonly description: string;
  readonly canonical: string;
  readonly bodyPage: string;
  readonly showFooter?: boolean;
  readonly lang: "en" | "de";
}

export interface Props {
  readonly title: string;
  readonly description: string;
  readonly canonical: string;
  readonly bodyPage: string;
  readonly lang: "en" | "de";
}

const {
  title = "Jan Volkert Ulrich | UI | UX | Design Solutions",
  description = "A UI / UX Designer for digital products, from concept to execution. Passionate about asking the right questions and finding the best solutions.",
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  bodyPage,
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Jan Volkert Ulrich" />
    <meta name="color-scheme" content="dark light" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
      type="image/png"
    />
    <link rel="manifest" href="/manifest.webmanifest" />

    <script is:inline>
      document.documentElement.className +=
        "ontouchstart" in document.documentElement ? " touch" : " no-touch";
    </script>
  </head>

  <body data-page={bodyPage}>
    <script is:inline>
      const theme = localStorage.getItem("vu-theme");

      if (!theme) {
        const prefersDarkTheme = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const newTheme = prefersDarkTheme ? "dark" : "light";

        localStorage.setItem("vu-theme", newTheme);
        document.documentElement.dataset.theme = newTheme;
      } else {
        document.documentElement.dataset.theme = theme;
      }
    </script>

    <slot />

    <Footer />

    <script is:inline>
      // Workaround for iOS and Desktop Safari
      // https://developer.apple.com/forums/thread/651215

      if (document.readyState !== "loading") {
        run();
      } else {
        document.addEventListener("DOMContentLoaded", function () {
          run();
        });
      }

      function run() {
        const toggle = document.querySelector("#theme-toggle");
        const currentYear = document.querySelector("[data-current-year]");

        Array.from(
          document.querySelectorAll("[data-email-user][data-email-domain]"),
        ).forEach((el) => {
          const email = `${atob(el.dataset.emailUser)}@${atob(el.dataset.emailDomain)}`;
          el.href = `mailto:${email}`;
        });

        if (currentYear) currentYear.textContent = new Date().getFullYear();
        if (toggle) {
          toggle.addEventListener("click", onThemeToggleClicked);
        }
      }

      function onThemeToggleClicked() {
        const prevTheme = document.documentElement.dataset.theme;
        const nextTheme = prevTheme === "light" ? "dark" : "light";
        const toggle = document.querySelector("#theme-toggle");

        localStorage.setItem("vu-theme", nextTheme);
        document.documentElement.dataset.theme = nextTheme;
        if (prevTheme) {
          toggle.classList.remove(prevTheme);
        }
        toggle.classList.add(nextTheme);
      }
    </script>
  </body>
</html>
